{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --legacy-peer-deps --include=dev",
  "buildCommand": "npx expo export -p web --clear",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "env": {
    "APP_ENV": "production",
    "API_BASE_URL": "https://api.lioris.app",
    "WS_BASE_URL": "wss://api.lioris.app/realtime",
    "EXPO_PUBLIC_SUPABASE_URL": "https://fdtnbluslkabwsmspbem.supabase.co",
    "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_TB0Pw8k2oJQTmoO951YaIQ_xzOyGpZF"
  },
  "build": {
    "env": {
      "APP_ENV": "production",
      "API_BASE_URL": "https://api.lioris.app",
      "WS_BASE_URL": "wss://api.lioris.app/realtime",
      "EXPO_PUBLIC_SUPABASE_URL": "https://fdtnbluslkabwsmspbem.supabase.co",
      "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_TB0Pw8k2oJQTmoO951YaIQ_xzOyGpZF"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
