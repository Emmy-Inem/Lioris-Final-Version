{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --legacy-peer-deps --include=dev",
  "buildCommand": "npx expo export -p web --clear",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "env": {
    "APP_ENV": "production",
    "API_BASE_URL": "https://api.lioris.app",
    "WS_BASE_URL": "wss://api.lioris.app/realtime",
    "EXPO_PUBLIC_SUPABASE_URL": "https://fdtnbluslkabwsmspbem.supabase.co",
    "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_TB0Pw8k2oJQTmoO951YaIQ_xzOyGpZF"
  },
  "build": {
    "env": {
      "APP_ENV": "production",
      "API_BASE_URL": "https://api.lioris.app",
      "WS_BASE_URL": "wss://api.lioris.app/realtime",
      "EXPO_PUBLIC_SUPABASE_URL": "https://fdtnbluslkabwsmspbem.supabase.co",
      "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_TB0Pw8k2oJQTmoO951YaIQ_xzOyGpZF"
    }
  },
  "rewrites": [
    {
      "source": "/((?!.well-known/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https: http:; connect-src 'self' blob: data: https://fdtnbluslkabwsmspbem.supabase.co wss://fdtnbluslkabwsmspbem.supabase.co https://api.lioris.app wss://api.lioris.app https://openlibrary.org https://api.semanticscholar.org https://api.openalex.org https://api.open-meteo.com https://open.er-api.com https://*.api.radio-browser.info https://meet.jit.si wss://meet.jit.si https://*.jit.si wss://*.jit.si https://nominatim.openstreetmap.org https://overpass-api.de https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com https://meet.jit.si https://*.jit.si https://8x8.vc https://*.8x8.vc https://www.openstreetmap.org https://*.openstreetmap.org https://maps.google.com https://www.google.com https://docs.google.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
