{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "env": {
    "APP_ENV": "production",
    "API_BASE_URL": "https://api.lioris.app",
    "WS_BASE_URL": "wss://api.lioris.app/realtime"
  },
  "build": {
    "env": {
      "APP_ENV": "production",
      "API_BASE_URL": "https://api.lioris.app",
      "WS_BASE_URL": "wss://api.lioris.app/realtime"
    }
  },
  "rewrites": [
    {
      "source": "/((?!_expo/|assets/|favicon\\.png|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
