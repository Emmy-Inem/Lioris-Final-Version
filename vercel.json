{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "env": {
    "APP_ENV": "production",
    "API_BASE_URL": "https://api.lioris.app",
    "WS_BASE_URL": "wss://api.lioris.app/realtime"
  },
  "build": {
    "env": {
      "APP_ENV": "production",
      "API_BASE_URL": "https://api.lioris.app",
      "WS_BASE_URL": "wss://api.lioris.app/realtime"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://fdtnbluslkabwsmspbem.supabase.co https://*.supabase.co https://images.unsplash.com; media-src 'self' data: blob: https://fdtnbluslkabwsmspbem.supabase.co https://*.supabase.co; connect-src 'self' https://fdtnbluslkabwsmspbem.supabase.co wss://fdtnbluslkabwsmspbem.supabase.co https://*.supabase.co wss://*.supabase.co https://api.lioris.app wss://api.lioris.app https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
