{
  "name": "lioris",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build": "cross-env APP_ENV=production expo export -p web --clear",
    "build:web": "cross-env APP_ENV=production expo export -p web --clear",
    "export": "cross-env APP_ENV=production expo export -p web --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node -e \"const fs=require('fs'),cp=require('child_process');const f=fs.readdirSync('src/utils').filter(n=>/.test.ts$/.test(n)).map(n=>'src/utils/'+n);if(!f.length){console.log('No unit tests found.');process.exit(0)}process.exit(cp.spawnSync(process.execPath,['--test',...f],{stdio:'inherit'}).status??1)\"",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=list,github,html",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "^5.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.3",
    "axios": "^1.18.1",
    "cross-env": "^10.1.0",
    "expo": "~57.0.22",
    "expo-blur": "~57.0.3",
    "expo-constants": "^57.0.6",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.4",
    "expo-font": "^57.0.1",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-router": "~58.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "babel-preset-expo": "^57.0.3",
    "eslint": "^10.8.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "browserslist": "^4.29.0",
    "baseline-browser-mapping": "^2.11.25",
    "uuid": "^11.1.1",
    "query-string": "^7.1.3"
  }
