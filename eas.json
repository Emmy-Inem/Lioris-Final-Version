{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "API_BASE_URL": "https://api.dev.lioris.app",
        "WS_BASE_URL": "wss://api.dev.lioris.app/realtime"
      },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging",
        "API_BASE_URL": "https://api.staging.lioris.app",
        "WS_BASE_URL": "wss://api.staging.lioris.app/realtime"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "API_BASE_URL": "https://api.lioris.app",
        "WS_BASE_URL": "wss://api.lioris.app/realtime"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
